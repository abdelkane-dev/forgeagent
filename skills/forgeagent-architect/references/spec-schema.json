{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeAgentSpecification",
  "type": "object",
  "required": ["name", "role", "mission", "type", "model", "allowedActions", "forbiddenActions", "tools"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique display name of the agent"
    },
    "role": {
      "type": "string",
      "description": "Professional title or role"
    },
    "mission": {
      "type": "string",
      "description": "Concise summary of the agent's objective"
    },
    "type": {
      "type": "string",
      "enum": ["decision", "monitoring", "data", "development", "conversational"]
    },
    "model": {
      "type": "string",
      "enum": ["claude-3-5-haiku-latest", "claude-3-5-sonnet-latest", "claude-3-opus-latest"]
    },
    "autonomy": {
      "type": "string",
      "enum": ["supervised", "semi-autonomous", "autonomous"],
      "default": "supervised"
    },
    "allowedActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbiddenActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["connectorId", "access"],
        "properties": {
          "connectorId": { "type": "string" },
          "access": { "type": "string", "enum": ["read", "read_write"] },
          "annotations": {
            "type": "object",
            "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
            "properties": {
              "readOnlyHint": { "type": "boolean" },
              "destructiveHint": { "type": "boolean" },
              "idempotentHint": { "type": "boolean" },
              "openWorldHint": { "type": "boolean" }
            }
          }
        }
      }
    },
    "costCapPerDay": {
      "type": "number",
      "minimum": 0.1,
      "default": 5.0
    }
  }
}
